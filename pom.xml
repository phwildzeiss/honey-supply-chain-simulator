<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>h.burgenland</groupId>
    <artifactId>honey-supply-chain-simulator</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>honey-supply-chain-simulator</name>
    <description>Case study simulator: plays the laboratory, award body, certification body and sensors for the honey-supply-chain dApp</description>

    <properties>
        <java.version>21</java.version>
        <web3j.version>5.0.2</web3j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.web3j</groupId>
            <artifactId>core</artifactId>
            <version>${web3j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.web3j</groupId>
                <artifactId>web3j-maven-plugin</artifactId>
                <version>${web3j.version}</version>
                <configuration>
                    <abiSourceFiles>
                        <directory>../honey-supply-chain/artifacts/contracts</directory>
                        <includes>
                            <include>ActorRegistry.sol/ActorRegistry.json</include>
                            <include>ConsumerGateway.sol/ConsumerGateway.json</include>
                            <include>HoneyToken.sol/HoneyToken.json</include>
                            <include>PricingModel.sol/PricingModel.json</include>
                            <include>QualityIndex.sol/QualityIndex.json</include>
                            <include>SupplyChain.sol/SupplyChain.json</include>
                        </includes>
                    </abiSourceFiles>
                    <packageName>h.burgenland.simulator.web3.generated</packageName>
                    <sourceDestination>src/main/java</sourceDestination>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
